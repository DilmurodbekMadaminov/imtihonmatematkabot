rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function hasOnlyAllowedFields(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }
    
    function isValidUser() {
      let data = request.resource.data;
      return hasOnlyAllowedFields(['timestamp', 'firstName', 'lastName', 'username']) &&
             data.timestamp is number &&
             (!('firstName' in data) || data.firstName is string) &&
             (!('lastName' in data) || data.lastName is string) &&
             (!('username' in data) || data.username is string);
    }

    match /users/{userId} {
      // Allow read/write for the bot server. 
      // In a production environment with a service account, this would be restricted.
      allow read: if true;
      allow create, update: if isValidUser();
      allow delete: if false;
    }
  }
}
