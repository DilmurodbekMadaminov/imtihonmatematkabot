rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /settings/{docId} {
      allow read, write: if true;
    }
    match /pdf_tests/{docId} {
      allow read, write: if true;
    }
    match /pdf_test_results/{docId} {
      allow read, write: if true;
    }
  }
}
